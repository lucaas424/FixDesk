@startuml
title FixDesk - Diagrama de Secuencia\nCaso de Uso: Cambiar estado de reparación

actor Tecnico

participant "OrdenController" as Controller
participant "OrdenService" as Service
participant "OrdenRepository" as Repository
participant "OrdenReparacion" as Orden
participant "HistorialRepository" as HistorialRepo
participant "NotificacionService" as NotifService
participant "NotificacionRepository" as NotifRepo
database "MySQL\nfixdesk_db" as DB

Tecnico -> Controller : solicitarCambioEstado(ordenId, nuevoEstado)

Controller -> Service : cambiarEstado(ordenId, nuevoEstado, usuarioActual)

Service -> Repository : buscarPorId(ordenId)

Repository -> DB : SELECT orden
DB --> Repository : datos de la orden
Repository --> Service : OrdenReparacion

alt Orden inexistente

    Service --> Controller : error("Orden no encontrada")
    Controller --> Tecnico : mostrar mensaje de error

else Orden encontrada

    Service -> Service : validarPermisos(usuarioActual, orden)

    alt Tecnico no autorizado

        Service --> Controller : error("Sin permisos")
        Controller --> Tecnico : mostrar acceso denegado

    else Usuario autorizado

        Service -> Service : validarTransicion(estadoActual, nuevoEstado)

        alt Transicion no permitida

            Service --> Controller : error("Transicion invalida")
            Controller --> Tecnico : mostrar estado no permitido

        else Transicion valida

            Service -> Orden : cambiarEstado(nuevoEstado)
            Orden --> Service : estado actualizado

            Service -> Repository : guardar(orden)

            Repository -> DB : UPDATE orden_reparacion
            DB --> Repository : confirmacion
            Repository --> Service : orden guardada

            Service -> HistorialRepo : registrarCambio(orden, estadoAnterior,\nnuevoEstado, usuarioActual)

            HistorialRepo -> DB : INSERT historial_estado
            DB --> HistorialRepo : confirmacion
            HistorialRepo --> Service : historial registrado

            alt nuevoEstado == LISTO_PARA_RETIRAR

                Service -> NotifService : generarNotificacion(cliente, orden)

                NotifService -> NotifRepo : guardar(notificacion)

                NotifRepo -> DB : INSERT notificacion
                DB --> NotifRepo : confirmacion
                NotifRepo --> NotifService : notificacion creada

                NotifService --> Service : notificacion generada

            end

            Service --> Controller : cambio exitoso
            Controller --> Tecnico : mostrar nuevo estado

        end

    end

end

@enduml