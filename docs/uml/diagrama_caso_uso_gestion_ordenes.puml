@startuml diagrama_caso_uso_gestion_ordenes
title FixDesk - Caso de Uso Detallado\nGestión de Órdenes de Reparación

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 45

actor Administrador
actor Tecnico

rectangle "FixDesk - Gestión de Órdenes" {

    usecase "Crear orden\nde reparación" as Crear

    usecase "Consultar orden" as Consultar

    usecase "Consultar y filtrar\nórdenes" as Filtrar

    usecase "Asignar técnico" as Asignar

    usecase "Reasignar técnico" as Reasignar

    usecase "Cambiar prioridad" as Prioridad

    usecase "Cambiar estado" as Estado

    usecase "Cancelar orden" as Cancelar

    usecase "Registrar cambio\nen historial" as Historial

    usecase "Generar notificación\nal cliente" as Notificar
}

Administrador --> Crear
Administrador --> Consultar
Administrador --> Filtrar
Administrador --> Asignar
Administrador --> Reasignar
Administrador --> Prioridad
Administrador --> Estado
Administrador --> Cancelar

Tecnico --> Consultar
Tecnico --> Estado

Estado ..> Historial : <<include>>

Notificar ..> Estado : <<extend>>\n[LISTO_PARA_RETIRAR]

@enduml